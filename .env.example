# Copy to .env for local use. Never commit .env.
#
# Address of your form service (Formspree, Web3Forms, Getform or your own endpoint).
# Leave empty to let the forms open the visitor's email app instead.
# It must be an https:// URL. It is public by design: it is not a secret key.
PUBLIC_FORM_ENDPOINT=

# Google Search Console "HTML tag" verification token: only the content="..." value, not the whole tag.
# Not needed if you verify the domain with a DNS TXT record instead (recommended). It is public by design.
PUBLIC_GSC_VERIFICATION=

# Address of your newsletter sign-up service (MailerLite, Mailchimp...). Must be https://.
# The sign-up box in the footer is hidden until this is set. It is public by design.
PUBLIC_NEWSLETTER_ENDPOINT=

# GoatCounter site code for cookie-free, anonymous visit counting (https://www.goatcounter.com, free for non-commercial use).
# Only the code, for example "eagleswings" if your dashboard is eagleswings.goatcounter.com. Leave empty to count nothing.
PUBLIC_GOATCOUNTER=

# Web3Forms access key for the website forms. Public by design. The old site's key is the default; set another here, or 'off' to disable the form service.
PUBLIC_WEB3FORMS_KEY=
