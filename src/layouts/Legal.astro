---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
  intro?: string;
}
const { title, description, updated = '16 October 2026', intro } = Astro.props;
---
<Base title={title} description={description}>
  <div class="page-head">
    <div class="wrap">
      <p class="crumb"><a href="/">Home</a> / {title}</p>
      <h1>{title}</h1>
      {intro && <p class="page-intro">{intro}</p>}
    </div>
  </div>
  <article class="legal-page">
    <p class="updated">Last updated: {updated}</p>
    <slot />
  </article>
</Base>
