---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import '../styles/sections.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { BOOT } from '../lib/boot';
import { altFor, sw, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** Optional hero image (a URL under /img/) to preload for a faster first paint. */
  preload?: string;
  noindex?: boolean;
  /** Page language. Swahili pages pass 'sw'. */
  lang?: Lang;
}
const { title, description, preload, noindex = false, lang = 'en' } = Astro.props;
const alt = altFor(Astro.url.pathname, lang);
const enHref = lang === 'en' ? Astro.url.pathname : alt?.href;
const swHref = lang === 'sw' ? Astro.url.pathname : alt?.href;
const t = lang === 'sw';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Keep titles within about 70 characters (search results cut longer ones off): drop the site name if a post title is long.
const withSite = `${title} | ${site.name}`;
const fullTitle = withSite.length <= 70 ? withSite : title;
const ogImage = new URL('/og-default.jpg', Astro.site);

// Content-Security-Policy (production only, so the dev server keeps working).
// The one inline script is allowed by its hash; everything else must come from this site.
const bootHash = createHash('sha256').update(BOOT).digest('base64');
// Only an https:// form service is accepted; anything else is ignored rather than weakening the policy.
const endpointOrigin = /^https:\/\//.test(site.formEndpoint) ? new URL(site.formEndpoint).origin : '';
const newsletterOrigin = /^https:\/\//.test(site.newsletterEndpoint) ? new URL(site.newsletterEndpoint).origin : '';
const gcHost = site.analyticsCode ? `https://${site.analyticsCode}.goatcounter.com` : '';
const csp = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${bootHash}'${gcHost ? ' https://gc.zgo.at' : ''}`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self' ${endpointOrigin} ${newsletterOrigin} ${gcHost}`.trim(),
  "frame-src 'none'",
  "base-uri 'self'",
  `form-action 'self' ${endpointOrigin} ${newsletterOrigin}`.trim(),
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');

// Optional Google Search Console verification token (letters, numbers, - and _ only).
const gscRaw = (import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined)?.trim() ?? '';
const gsc = /^[A-Za-z0-9_-]{20,120}$/.test(gscRaw) ? gscRaw : '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.name,
  url: Astro.site,
  logo: new URL('/images/logo.jpg', Astro.site),
  image: ogImage,
  email: site.email,
  telephone: site.phoneTel,
  foundingDate: String(site.founded),
  areaServed: { '@type': 'Country', name: 'Kenya' },
  address: { '@type': 'PostalAddress', addressLocality: 'Mwihoko', addressCountry: 'KE' },
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', telephone: site.phoneTel, email: site.email, availableLanguage: ['English', 'Swahili'] },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Production builds only. PUBLIC_NO_CSP exists solely for building a throwaway copy for automated browser testing. */}
    {import.meta.env.PROD && !import.meta.env.PUBLIC_NO_CSP && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#12305b" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alt && enHref && swHref && <>
      <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
      <link rel="alternate" hreflang="sw" href={new URL(swHref, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(enHref, Astro.site)} />
    </>}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={t ? 'sw_KE' : 'en_KE'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: children and carers at the home in Mwihoko, Kenya`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href="/img/logo-380.webp" imagesrcset="/img/logo-190.webp 190w, /img/logo-380.webp 380w" imagesizes="190px" fetchpriority="high" />
    <link rel="preload" href="/fonts/playfair.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <script is:inline set:html={BOOT}></script>
    {site.analyticsCode && <script is:inline async data-goatcounter={`${gcHost}/count`} src="https://gc.zgo.at/count.js"></script>}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div id="loader" aria-hidden="true">
      <div class="loader-in">
        <img src="/img/logo-380.webp" srcset="/img/logo-190.webp 190w, /img/logo-380.webp 380w" sizes="190px" alt="" width="190" height="190" fetchpriority="high" />
        <span class="loader-bar"><i></i></span>
      </div>
    </div>
    <a class="skip" href="#main">{t ? sw.skip : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer lang={lang} />
    <aside class="floaters" aria-label="Quick actions">
    <a class="wa-float" href={site.whatsapp} target="_blank" rel="noopener" aria-label={t ? sw.whatsappLabel : 'Chat with us on WhatsApp (opens in a new tab)'}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.6.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"/></svg>
    </a>
    <div class="cookie" id="cookie" role="region" aria-label={t ? sw.cookie.label : 'Cookie notice'} hidden>
      {t ? <p>{sw.cookie.text}</p> : <p><strong>Cookies, in short:</strong> we do not use tracking or advertising cookies. We only remember that you have seen this message.</p>}
      <div class="cookie-actions">
        <button class="btn sm4" id="cookie-ok" type="button">{t ? sw.cookie.ok : 'Got it'}</button>
        <a class="link plain" href="/cookies/">{t ? sw.cookie.policy : 'Cookie Policy'}</a>
      </div>
    </div>
    </aside>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
