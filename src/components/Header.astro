---
import { nav } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<div class="top-zone" id="top-zone" aria-hidden="true"></div>
<header class="top" id="top">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/img/logo-96.webp" srcset="/img/logo-96.webp 1x, /img/logo-192.webp 2x" alt="" width="46" height="46" />
      <span>Eagle's Wings<br />Community Group</span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav" id="menu-btn"><i></i><i></i><span class="sr">Menu</span></button>
    <nav id="nav" aria-label="Main">
      <ul>
        {nav.map((n, i) => <li style={`--n:${i}`}><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li style={`--n:${nav.length}`}><a class="btn sm" href="/give/">Give</a></li>
      </ul>
    </nav>
  </div>
</header>
