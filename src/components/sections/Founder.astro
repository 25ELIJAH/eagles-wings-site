---
import Photo from '../Photo.astro';
import { founder } from '../../data/site';
import { hasOwnPhoto } from '../../lib/photos';

const ownPhoto = hasOwnPhoto('benard');
---
<!-- FOUNDER: round photos -->
<section class="soft founder" id="founder">
  <div class="wrap founder-grid">
    <div class="rounds reveal">
      <span class="dots" aria-hidden="true"></span>
      <span class="round big">{ownPhoto
        ? <Photo name="benard" label={`${founder.name}, ${founder.role}`} />
        : <span class="monogram" role="img" aria-label={`${founder.name}, ${founder.role}`}>{founder.name.split(' ').filter((w) => !/^rev\.?$/i.test(w)).map((w) => w[0]).join('').slice(0, 2)}</span>}</span>
      <span class="round sm1"><Photo name="founder-2" label="" /></span>
      <span class="round sm2"><Photo name="founder-3" label="" /></span>
    </div>
    <div class="reveal" style="--d:.1s">
      <p class="tagline">{founder.label}</p>
      <h2>{founder.name}</h2>
      <blockquote class="quote">
        <p>{founder.quote}</p>
        <footer>{founder.name}, {founder.role}</footer>
      </blockquote>
    </div>
  </div>
</section>
