---
import { timeline } from '../../data/org';
---
<section class="timeline" aria-labelledby="tl-title">
  <div class="wrap narrow-wrap">
    <h2 id="tl-title" class="reveal">Our journey</h2>
    <ol class="tl-list">
      {timeline.map((t) => (
        <li class="reveal"><span class="tl-when">{t.when}</span><p>{t.text}</p></li>
      ))}
    </ol>
    <p class="tl-more">More milestones will be added here as the work grows.</p>
  </div>
</section>
