---
import Photo from '../Photo.astro';
import { gallery } from '../../data/site';
import { galleryNames as names, photoUrl, resolvePhoto } from '../../lib/photos';

const galleryNames = names(gallery.items.length);
---
<!-- PHOTO STRIP: edge to edge -->
<section class="strip-sec" id="gallery" aria-label={gallery.title}>
  <ul class="strip" role="list">
    {gallery.items.map((g, i) => (
      <li class="reveal" style={`--d:${(i % 4) * 0.05}s`}>
        <button
          class="shot"
          type="button"
          aria-label={`View photo ${i + 1} of ${gallery.items.length} larger`}
          aria-haspopup="dialog"
          data-full={photoUrl(galleryNames[i], 1600)}
          data-alt={resolvePhoto(galleryNames[i])?.own ? g.caption : ''}
        >
          <Photo name={galleryNames[i]} label={g.caption} alt={g.caption} sizes="(max-width: 980px) 50vw, 25vw" />
        </button>
      </li>
    ))}
  </ul>
</section>

<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lb-x" id="lb-x" type="button" aria-label="Close photo viewer">&times;</button>
  <button class="lb-n lb-p" id="lb-p" type="button" aria-label="Previous photo">&#8592;</button>
  <figure><img id="lb-i" src="" alt="" /></figure>
  <button class="lb-n lb-nx" id="lb-nx" type="button" aria-label="Next photo">&#8594;</button>
</div>
