---
import Photo from '../Photo.astro';
import { programs } from '../../data/site';

const progPhotos = ['feeding', 'mentorship', 'medical'];
const progLabels = ['Feeding program', 'Youth mentorship', 'Medical outreach'];
---
<!-- PROGRAMS: rounded cards -->
<section id="programs">
  <div class="wrap">
    <header class="head center reveal">
      <h2>{programs.title}</h2>
    </header>
    <div class="pcards">
      {programs.items.map((p, i) => (
        <article class="pcard reveal" style={`--d:${i * 0.1}s`} id={p.id}>
          <div class="pcard-photo"><Photo name={progPhotos[i]} label={progLabels[i]} sizes="(max-width: 980px) 100vw, 370px" /></div>
          <div class="pcard-body">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a class="btn dark sm3" href="/give/">Support this</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
