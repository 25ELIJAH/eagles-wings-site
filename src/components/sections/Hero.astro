---
import Photo from '../Photo.astro';
import { hero, heroBadge } from '../../data/site';
import { KENYA_PATH, KENYA_W, KENYA_H } from '../../data/kenya';
import { bgSlides, kenyaPortrait } from '../../lib/photos';
import { tornPath } from '../../lib/torn';

const slides = bgSlides();
const { src: kenyaSrc, img: kImg } = kenyaPortrait();
const [hlWord, ...hlWords] = hero.italic.split(' ');
const hlRest = hlWords.join(' ');
const tornBack = tornPath(7, 74, 26, 11);
const tornFront = tornPath(31, 96, 24, 9);
---
<!-- HERO: sage background, Kenya-shaped portrait, torn-paper edge -->
<section class="hero" id="home">
  <div class="hero-bg" aria-hidden="true" data-slides>
    {slides.map((src, i) => (
      <div class={`sl${i === 0 ? ' on' : ''}`} style={i === 0 ? `background-image:url('${src}')` : undefined} data-bg={i === 0 ? undefined : src}></div>
    ))}
  </div>
  <span class="stroke s1" aria-hidden="true"></span>
  <span class="stroke s2" aria-hidden="true"></span>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>{hero.plain} <span class="hl">{hlWord}</span> {hlRest}</h1>
      <p class="lede">{hero.text}</p>
      <div class="actions">
        <a class="btn dark" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="link plain" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>

    <div class="hero-art">
      <svg class="kenya" viewBox={`-16 -16 ${KENYA_W + 32} ${KENYA_H + 32}`} role="img" aria-label="Map of Kenya containing a portrait of a smiling girl">
        <defs>
          <clipPath id="kenya-clip"><path d={KENYA_PATH} /></clipPath>
          <filter id="kenya-shadow" x="-10%" y="-10%" width="125%" height="125%"><feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#12305b" flood-opacity=".28" /></filter>
        </defs>
        <path d={KENYA_PATH} fill="#fff" filter="url(#kenya-shadow)" />
        <image href={kenyaSrc} x={kImg.x} y={kImg.y} width={kImg.w} height={kImg.h} preserveAspectRatio={kImg.par} clip-path="url(#kenya-clip)" />
        <path class="kenya-line" d={KENYA_PATH} fill="none" stroke="#fff" stroke-width="5" stroke-linejoin="round" />
      </svg>
      <div class="seal"><b><span data-roll={heroBadge.n}></span>+</b><span>{heroBadge.label}</span></div>
    </div>
  </div>

  <div class="hero-pair" aria-hidden="true"><Photo name="collage-2" label="" /></div>
  <span class="stroke s3" aria-hidden="true"></span>
  <button class="slides-toggle" type="button" data-slides-toggle aria-pressed="false" aria-label="Pause background photo slideshow">
    <span class="ico-pause" aria-hidden="true"></span>
  </button>
  <svg class="torn" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
    <path class="torn-back" d={tornBack} />
    <path class="torn-front" d={tornFront} />
  </svg>
</section>
