---
import { sw } from '../../lib/i18n';
import { founder } from '../../data/site';
---
<section class="sw-founder soft">
  <div class="wrap narrow-wrap reveal">
    <p class="eyebrow">{sw.founder.label}</p>
    <blockquote>{sw.founder.quote}</blockquote>
    <p class="sw-sign"><strong>{founder.name}</strong>, {sw.founder.role}</p>
    <p class="small">{sw.founder.note}</p>
  </div>
</section>
