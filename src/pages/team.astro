---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Fill from '../components/Fill.astro';
import DonationBanner from '../components/sections/DonationBanner.astro';
import { team } from '../data/org';
import { hasOwnPhoto } from '../lib/photos';

const photoKey = (slug: string) => (slug === 'martin' ? 'martin' : `team-${slug}`);
---
<Base title="Our team" description="Meet the people behind Eagle's Wings Community Group: our founder, leaders and volunteers working across Kenya.">
  <PageHero title="Our team" subtitle="The people who make the work happen." image="page-about" />
  <section class="team">
    <div class="wrap">
      <ul class="team-grid" role="list">
        {team.map((p, i) => (
          <li class="person reveal" style={`--d:${i * 0.08}s`}>
            <div class="person-photo">
              {hasOwnPhoto(photoKey(p.slug))
                ? <Photo name={photoKey(p.slug)} label={`${p.name}, ${p.role}`} sizes="(max-width: 700px) 100vw, 300px" />
                : <span class="monogram" role="img" aria-label={p.name}>{p.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>}
            </div>
            <h2>{p.name}</h2>
            <p class="role">{p.role}</p>
            {p.bio && <p class="bio">{p.bio}</p>}
          </li>
        ))}
      </ul>
      <p class="team-note"><Fill>Add your board members, advisers and key volunteers in src/data/org.ts, with their agreement. Named people build trust.</Fill></p>
    </div>
  </section>
  <DonationBanner />
</Base>
